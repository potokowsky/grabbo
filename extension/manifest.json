{
  "manifest_version": 3,
  "name": "Grabbo",
  "version": "0.4.1",
  "description": "Detects videos on the page and downloads them in the chosen quality (with the yt-dlp helper).",
  "key": "",
  "permissions": [
    "webRequest",
    "storage",
    "downloads",
    "nativeMessaging",
    "tabs",
    "cookies",
    "declarativeNetRequestWithHostAccess",
    "contextMenus",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Grabbo",
    "default_icon": {
      "16": "icons/off-16.png",
      "32": "icons/off-32.png",
      "48": "icons/off-48.png",
      "128": "icons/off-128.png"
    }
  },
  "icons": {
    "16": "icons/on-16.png",
    "48": "icons/on-48.png",
    "128": "icons/on-128.png"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "commands": {
    "download-current": {
      "suggested_key": {
        "default": "Alt+Shift+D",
        "mac": "Alt+Shift+D"
      },
      "description": "Download video from the current tab (default quality)"
    }
  }
}